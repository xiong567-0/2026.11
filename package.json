{
  "name": "weiyu-micro-posts",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "微语 · Micro Posts —— 基于 Vue 3 + Pinia 的轻量短文本发布页，数据保存在浏览器 localStorage",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
